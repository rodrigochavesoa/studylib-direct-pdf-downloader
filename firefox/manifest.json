{
  "manifest_version": 3,
  "name": "StudyLib Direct PDF Downloader",
  "version": "1.0.0",
  "description": "Exibe um botão para baixar o PDF associado a uma página do StudyLib.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads"],
  "host_permissions": ["https://*.studylib.net/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "studylib-direct-pdf-downloader@example.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://studylib.net/doc/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
